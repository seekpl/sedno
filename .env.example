# Sedno — zmienne środowiskowe (PROMPT.md §4). Skopiuj do .env.local i uzupełnij.

# Supabase (region UE): baza, auth (magic link), storage logo. Faza 2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer. Nigdy nie wystawiaj do przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (tryb testowy do czasu startu). Faza 3.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SINGLE_REPORT=

# Adres strony, np. https://sedno.example (metadane, sitemap, linki do raportów).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link do darmowego szablonu raportu. Pusty = na stronie „Wkrótce” bez linku.
NEXT_PUBLIC_TEMPLATE_URL=

# Adresy e-mail z dostępem do /app/admin/metryki, rozdzielone przecinkami.
ADMIN_EMAILS=
